# Copy to .env, fill in, then: chmod 600 .env
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID. Leave empty on first run, send /id to the bot, then fill it in and restart.
ALLOWED_USER_ID=

# Summary model (OpenAI-compatible API). Default: GapGPT + Gemini.
LLM_API_KEY=
LLM_BASE_URL=https://api.gapgpt.app/v1
LLM_MODEL=gemini-3.5-flash

# Speech-to-text (OpenAI-compatible /audio/transcriptions). Default: Groq (free tier).
# To use GapGPT for this too: STT_API_KEY=<same GapGPT key>, STT_BASE_URL=https://api.gapgpt.app/v1,
# and set STT_MODEL to the Whisper model name shown on the GapGPT pricing page.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# Optional
DEFAULT_LANG=fa
MAX_REEL_SECONDS=900
