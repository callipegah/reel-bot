# Copy to .env, fill in, then: chmod 600 .env
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Your Telegram user ID. Leave empty on first run, send /id to the bot, then fill it in and restart.
ALLOWED_USER_ID=
# Optional
CLAUDE_MODEL=claude-sonnet-5-5
GROQ_MODEL=whisper-large-v3-turbo
DEFAULT_LANG=fa
MAX_REEL_SECONDS=900
